load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_toolchain")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load(":toolchain.bzl", "dummy_cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "empty",
    srcs = [],
)

filegroup(
    name = "static_runtime",
    srcs = ["dummy.a"],
)

filegroup(
    name = "dynamic_runtime",
    srcs = ["dummy.so"],
)

dummy_cc_toolchain_config(name = "dummy_cc_toolchain_config")

cc_toolchain(
    name = "dummy_cc_toolchain_impl",
    all_files = ":empty",
    ar_files = ":empty",
    as_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    dynamic_runtime_lib = ":dynamic_runtime",
    linker_files = ":empty",
    objcopy_files = ":empty",
    static_runtime_lib = ":static_runtime",
    strip_files = ":empty",
    supports_param_files = True,
    toolchain_config = ":dummy_cc_toolchain_config",
    toolchain_identifier = "dummy-cc-toolchain",
)

toolchain(
    name = "dummy_cc_toolchain",
    toolchain = ":dummy_cc_toolchain_impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

cc_binary(
    name = "cc_runtime_selection",
    srcs = ["main.cc"],
    linkstatic = True,
)

rust_binary(
    name = "rust_runtime_selection",
    srcs = ["main.rs"],
    edition = "2021",
    experimental_use_cc_common_link = 1,
)

cc_library(
    name = "shared_link_dep",
    srcs = ["link_dep.so"],
)

cc_binary(
    name = "cc_link_deps_runfiles",
    srcs = ["main.cc"],
    linkstatic = True,
    deps = [":shared_link_dep"],
)

rust_binary(
    name = "rust_link_deps_runfiles",
    srcs = ["main.rs"],
    edition = "2021",
    experimental_use_cc_common_link = 1,
    link_deps = [":shared_link_dep"],
)
